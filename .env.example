# ==========================================
# PDF RAG Application Configuration
# ==========================================

# Directory Paths
DOCUMENTS_DIR=./documents
CHROMA_DB_DIR=./chroma_db

# ChromaDB Settings
CHROMA_COLLECTION_NAME=rag_documents

# Embedding Model (Sentence Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Text Chunking Settings (approximately characters or tokens)
# A typical rule of thumb: 1 token ≈ 4 characters in English
# Chunk size 500 tokens ≈ 2000 characters; overlap 100 tokens ≈ 400 characters
CHUNK_SIZE=2000
CHUNK_OVERLAP=400

# Retrieval Settings
# TOP_K: Number of relevant chunks to retrieve (3 to 5)
TOP_K=4

# RELEVANCE_THRESHOLD: Distance threshold for ChromaDB (using cosine distance).
# Cosine distance = 1.0 - Cosine Similarity.
# Distance 0.0 means identical; 1.0 means unrelated.
# For all-MiniLM-L6-v2, natural questions typically score 0.20-0.78 against relevant passages,
# while completely irrelevant questions score >= 0.90.
RELEVANCE_THRESHOLD=0.80

# LLM Provider: 'groq' for ultra-fast online LLM (recommended for lower RAM PCs), or 'ollama' for local offline
LLM_PROVIDER=groq

# Groq (Online Cloud LLM) Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Local LLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

