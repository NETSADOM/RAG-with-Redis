# ==========================================
# NovaCart Customer Support RAG Configuration
# ==========================================

# ------------------------------------------
# Redis Caching Settings
# ------------------------------------------
# Connection string for Redis instance (port 6379)
# If Redis is not running or unreachable, the system automatically falls back
# to in-memory caching via fakeredis without crashing.
REDIS_URL=redis://127.0.0.1:6379/0

# Default cache Time-To-Live in seconds (1 hour = 3600s)
CACHE_TTL=3600

# Redis Eviction Policy: allkeys-lfu preserves frequently accessed customer support FAQs
REDIS_MAXMEMORY_POLICY=allkeys-lfu

# Admin Authentication Token for protected endpoints (/api/cache/clear, /api/kb/update-policy)
ADMIN_API_KEY=novacart-admin-key-2026

# Semantic Caching for Paraphrased / Equivalent Questions (default: false, opt-in)
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.88

# ------------------------------------------
# LLM Generation (OpenAI / Groq API compatible)
# ------------------------------------------
# Primary OpenAI-compatible API key (works with OpenAI, Groq, Together, DeepSeek, or local Ollama)
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# Base URL for API requests:
# - OpenAI: https://api.openai.com/v1
# - Groq:   https://api.groq.com/openai/v1
# - Ollama: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Model Name
# Examples: gpt-4o-mini, gpt-3.5-turbo, llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Optional Groq fallback settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# Hybrid Retrieval & Reranking Models
# ------------------------------------------
# Dense embedding model (HuggingFace Sentence Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Cross-Encoder Reranker model (HuggingFace)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Reciprocal Rank Fusion smoothing parameter
RRF_K=60

# Number of top candidate passages passed to Cross-Encoder reranker
RETRIEVAL_TOP_K=10

# Final top reranked chunks provided to the LLM generator
RERANKER_TOP_K=4
