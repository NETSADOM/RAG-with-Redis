# Redis is mandatory at startup; runtime outages temporarily bypass caching. Paste the database connection URL from your provider.
# redis:// = unencrypted; rediss:// = TLS (must be enabled by the provider).
# URL-encode special characters in a username/password. Never commit this value.
REDIS_URL=
CACHE_TTL=86400

# Leave blank to disable administrative routes. Set a private random value to enable.
ADMIN_API_KEY=

# One server worker. Public requests are limited per client address.
CHAT_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_GENERATIONS=2
# Optional actual human-support destination shown after unsupported questions.
SUPPORT_CONTACT_URL=

# Document-grounded LLM. Gemini takes priority, then Groq, then OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
